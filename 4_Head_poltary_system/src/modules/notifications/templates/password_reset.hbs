<!doctype html>
<html lang="en">
  <body style="margin:0;background:#f5f7fb;font-family:Arial,sans-serif;color:#14213d">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
      <tr>
        <td align="center" style="padding:32px 16px">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#fff;border:1px solid #e2e8f0;border-radius:12px">
            <tr><td style="padding:32px">
              <h1 style="margin:0 0 16px;font-size:22px">Reset your password</h1>
              <p style="line-height:1.6">{{message}}</p>
              <p style="margin:28px 0">
                <a href="{{resetUrl}}" style="background:#f59e0b;color:#111827;text-decoration:none;font-weight:700;padding:12px 18px;border-radius:8px">Reset password</a>
              </p>
              <p style="font-size:13px;color:#64748b;line-height:1.5">This link expires in {{expiresIn}}. If you did not request it, you can safely ignore this email.</p>
            </td></tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
